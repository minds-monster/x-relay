{
  "name": "x-relay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ToS-compliant X posting connector for Animoca Hello Minds",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.ops.json",
    "test": "vitest run",
    "db:local": "wrangler d1 execute x-relay --local --file=schema.sql",
    "db:remote": "wrangler d1 execute x-relay --remote --file=schema.sql",
    "ops": "node --env-file=.env --experimental-strip-types"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@animocabrands/minds-client-lib": "0.1.3",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.0.0"
  }
}
