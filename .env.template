# Config for the ops/ scripts (local Node only — never deployed).
#
#   cp .env.template .env      then fill in the values below.
#
# .env is gitignored. This template must NEVER contain a real value: it is committed,
# and a credential pasted here is a credential published. It happened once already —
# the builder JWT sat in this file across every commit in the repo.

# Animoca Minds builder API key. This is an ACCOUNT-ADMIN credential with a ~1 year
# lifetime. It must never reach the Worker, a Mind message, or a commit; only ops/ reads it.
MINDS_BUILDER_API_KEY=

# The deployed relay's public origin.
RELAY_BASE_URL=https://relay.minds.monster

# Admin key for /admin/* routes. Must match the ADMIN_KEY secret set on the Worker
# (`npx wrangler secret put ADMIN_KEY`), which is NOT the same as the local .dev.vars one.
ADMIN_KEY=

# Relay user to operate on.
RELAY_USER_ID=adam
